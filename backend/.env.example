PORT=4000
ADMIN_SECRET=change-me-admin

# Local file-based storage (default). Leave USE_FIRESTORE unset/false for local dev.
DATA_FILE=../data/data.json

# Set to true in production (Cloud Run) to persist state in Firestore instead
# of the local JSON file. Requires GOOGLE_APPLICATION_CREDENTIALS or running
# on GCP infrastructure with Firestore API enabled and IAM permissions granted.
USE_FIRESTORE=false

# Populated automatically by Cloud Run; only needed if serving the built
# frontend from this server (see Dockerfile).
STATIC_DIR=
